#define RT_MANIFEST 24
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

// Version info shown in the exe's Properties > Details. Keep the numbers equal to Cargo.toml's
// version; build.rs stops the build if they drift.
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Trimly"
            VALUE "FileDescription",  "Trimly"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "Trimly"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Trimly contributors"
            VALUE "OriginalFilename", "Trimly.exe"
            VALUE "ProductName",      "Trimly"
            VALUE "ProductVersion",   "0.1.0"
            VALUE "Comments",         "Keeps the apps you choose lean on memory. https://github.com/umamidayo/trimly"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
